    },
    "/auth/check": {
      "get": {
        "tags": ["Auth"],
        "summary": "Check authentication status",
        "description": "Checks if the user is authenticated based on the provided token.",
        "responses": {
          "200": {
            "description": "User is authenticated."
          },
          "401": {
            "description": "User is not authenticated."
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
