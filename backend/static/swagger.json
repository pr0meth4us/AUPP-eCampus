    "/auth/send-otp": {
      "post": {
        "tags": ["Auth"],
        "summary": "Send OTP",
        "description": "Sends a one-time password to the user's email for verification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully."
          },
          "400": {
            "description": "Email is required."
          },
          "409": {
            "description": "Email already registered."
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
