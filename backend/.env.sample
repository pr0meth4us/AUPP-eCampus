# MongoDB connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/your_db?retryWrites=true&w=majority

# Flask secret key (for sessions, WTForms, etc.)
SECRET_KEY=supersecretkey

# CORS: comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://your_production_domain.com

# Simple admin token for quick checks
ADMIN_TOKEN=yfuyiuytu

# Email SMTP password (for sending OTPs or notifications)
EMAIL_PASSWORD=your_email_password

# Redis (for caching, rate-limiting, etc.)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_if_any
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA


# Google Service Account (JSON fields)
TYPE=service_account
PROJECT_ID=your_google_project_id
PRIVATE_KEY_ID=abcdef1234567890
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
CLIENT_ID=12345678901234567890
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your_service_account_email
UNIVERSE_DOMAIN=googleapis.com

# Cloudinary (for image/file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_secret

# AWS credentials (if using AWS SDK, S3, etc.)
AWS_ACCESS_KEY_ID=AKIA…
AWS_SECRET_ACCESS_KEY=abcd1234…

# PayPal REST SDK
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# Client & Server URLs (for CORS, emails, redirects)
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5001

# Cloudflare R2 or similar S3-compatible storage
CLOUDFLARE_ACCESS_KEY_ID=cf_access_key
CLOUDFLARE_SECRET_ACCESS_KEY=cf_secret_key
CLOUDFLARE_BUCKET_NAME=your_bucket
CLOUDFLARE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_PUBLIC_URL=https://cdn.your_domain.com

# Supabase S3 (if using Supabase storage)
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co
SUPABASE_S3_REGION=us_east_1
SUPABASE_S3_ACCESS_KEY=your_supabase_key
SUPABASE_S3_SECRET_KEY=your_supabase_secret
SUPABASE_S3_BUCKET=submissions
SUPABASE_API_URL=https://your-project.supabase.co
